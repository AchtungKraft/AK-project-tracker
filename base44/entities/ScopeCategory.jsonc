{
  "name": "ScopeCategory",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Reference to ClientFeedbackRequest (scope review)"
    },
    "name": {
      "type": "string",
      "description": "Category name (e.g. MUST DO, RECOMMENDED, NICE TO HAVE)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual display order"
    }
  },
  "required": [
    "request_id",
    "name"
  ]
}