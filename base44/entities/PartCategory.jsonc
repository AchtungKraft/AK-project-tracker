{
  "name": "PartCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID for hierarchy"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "description": "Hex color for visual identification"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}