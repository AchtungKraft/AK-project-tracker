{
  "name": "PageBlock",
  "type": "object",
  "properties": {
    "page_id": {
      "type": "string",
      "description": "Reference to ClientPage"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "media",
        "links",
        "files",
        "cta"
      ],
      "description": "Block type"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "inline",
        "shared"
      ],
      "default": "inline",
      "description": "Whether block content is inline or from a shared block"
    },
    "shared_block_id": {
      "type": "string",
      "description": "Reference to SharedBlock when source_type is shared"
    },
    "data": {
      "type": "object",
      "description": "Block content data (used when source_type is inline)"
    }
  },
  "required": [
    "page_id",
    "type"
  ]
}