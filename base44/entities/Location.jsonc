{
  "name": "Location",
  "type": "object",
  "properties": {
    "location_area": {
      "type": "string",
      "description": "Main area (e.g., Shop Floor, Warehouse A)"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent location ID for hierarchy (e.g., Building > Floor > Area)"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "warehouse",
        "building",
        "room",
        "area",
        "zone",
        "aisle",
        "rack",
        "shelf",
        "bin",
        "cabinet",
        "drawer",
        "trailer",
        "cart",
        "engine_cart",
        "body_cart",
        "tech_cart",
        "pallet",
        "tote",
        "stand",
        "crate",
        "project_storage",
        "project_shelf",
        "project_cart",
        "engine_stand",
        "body_buck",
        "parts_tote",
        "staging",
        "receiving",
        "shipping",
        "inspection",
        "workstation",
        "assembly",
        "temporary",
        "other",
        "unclassified"
      ],
      "description": "Physical type classification for this location"
    },
    "short_code": {
      "type": "string",
      "description": "Short identifier for labels and quick reference (e.g., T2, EC-9106, A3-5)"
    },
    "storage_type": {
      "type": "string",
      "description": "Type of storage (e.g., Shelf, Bin, Pallet)"
    },
    "bin_description": {
      "type": "string",
      "description": "Specific location descriptor (e.g., A-3-5)"
    },
    "qr_code_value": {
      "type": "string",
      "description": "QR code value for scanning"
    },
    "notes": {
      "type": "string",
      "description": "Location notes"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of this location"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of location photo URLs"
    },
    "color": {
      "type": "string",
      "default": "#8B5CF6",
      "description": "Hex color for visual identification"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this location is active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to Project. Set for project-specific storage locations."
    },
    "is_project_storage": {
      "type": "boolean",
      "default": false,
      "description": "Whether this location is project-specific storage (vs general facility storage)"
    },
    "template_key": {
      "type": "string",
      "description": "Template key for idempotent project storage creation (e.g., main_shelf, engine_cart)"
    }
  },
  "required": [
    "location_area"
  ]
}