{
  "name": "TaskGroup",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Reference to ClientFeedbackRequest"
    },
    "name": {
      "type": "string",
      "description": "Group name"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order for sorting groups"
    }
  },
  "required": [
    "request_id",
    "name"
  ]
}