{
  "name": "QuickBooksExport",
  "type": "object",
  "properties": {
    "export_number": {
      "type": "string",
      "description": "Stable export identity (QBX-YYYYMMDD-XXXXXX). Stored on exported deposit invoices as qb_export_id."
    },
    "kind": {
      "type": "string",
      "enum": [
        "original",
        "regenerated"
      ],
      "enumColors": [
        "green",
        "yellow"
      ],
      "description": "original = file generated by an export; regenerated = rebuilt later from current records (never marks anything)"
    },
    "regenerated_from": {
      "type": [
        "string",
        "null"
      ],
      "description": "export_number of the original this file was regenerated from (null for a legacy export with no stored file)"
    },
    "project_id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Exact CSV text of the file (admin-only; capped at 900,000 characters)"
    },
    "content_sha256": {
      "type": "string"
    },
    "invoice_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invoice_snapshot": {
      "type": "array",
      "description": "Invoices in the file as they were when it was generated",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "qb_invoice_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "invoice_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subtotal": {
            "type": "number"
          },
          "line_count": {
            "type": "integer"
          }
        }
      }
    },
    "line_count": {
      "type": "integer"
    },
    "total_retail_sum": {
      "type": "number"
    },
    "total_cost_sum": {
      "type": "number"
    },
    "deposits_marked_exported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "differences": {
      "type": "array",
      "description": "Regenerated only: how this file differs from the original",
      "items": {
        "type": "string"
      }
    },
    "identical_to_original": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "created_by_email": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "export_number",
    "kind",
    "project_id",
    "file_name",
    "content",
    "content_sha256",
    "created_by_email",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "qb_export_service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "qb_export_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "qb_export_service_only"
      }
    }
  }
}