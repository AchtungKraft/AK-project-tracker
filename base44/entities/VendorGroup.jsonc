{
  "name": "VendorGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Group display name"
    },
    "vendor_type": {
      "type": "string",
      "enum": [
        "PART",
        "SERVICE"
      ],
      "description": "Which vendor domain this group belongs to"
    },
    "parent_group_id": {
      "type": "string",
      "description": "Reference to parent VendorGroup for hierarchy. Null/empty = root group."
    },
    "default_line_item_type": {
      "type": "string",
      "enum": [
        "vendor_cost",
        "shipping",
        "internal_labor",
        "misc"
      ],
      "default": "vendor_cost",
      "description": "Default line item type for services in this group. Drives behavior deterministically \u2014 no string guessing."
    },
    "sort_priority": {
      "type": "number",
      "default": 0,
      "description": "Sort order within its vendor_type"
    },
    "description": {
      "type": "string",
      "description": "Optional description of the group"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this group is active"
    }
  },
  "required": [
    "name",
    "vendor_type"
  ]
}