{
  "name": "StorageContainer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Container name (e.g. Blue Hardware Tote, Engine Crate #3)"
    },
    "container_type": {
      "type": "string",
      "enum": [
        "box",
        "tote",
        "bin",
        "tray",
        "organizer",
        "crate",
        "cart",
        "kit",
        "other"
      ],
      "default": "tote",
      "description": "Physical container type"
    },
    "location_id": {
      "type": "string",
      "description": "Reference to Location where this container currently sits"
    },
    "home_location_id": {
      "type": "string",
      "description": "Optional reference to Location where this container normally belongs"
    },
    "project_id": {
      "type": "string",
      "description": "Optional reference to Project this container is associated with"
    },
    "short_code": {
      "type": "string",
      "description": "Short identifier for labels and quick reference"
    },
    "photo": {
      "type": "string",
      "description": "Photo URL of this container"
    },
    "description": {
      "type": "string",
      "description": "Optional description"
    },
    "notes": {
      "type": "string",
      "description": "Short operational notes (e.g. Customer Supplied, Fragile, Do Not Stack)"
    },
    "color": {
      "type": "string",
      "default": "#6366F1",
      "description": "Hex color for visual identification"
    },
    "qr_code_value": {
      "type": "string",
      "description": "QR code value for scanning"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "empty",
        "archived"
      ],
      "default": "active",
      "description": "Container status"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this container is active"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the container contents were last physically verified"
    },
    "last_verified_by": {
      "type": "string",
      "description": "Full name of person who last verified the contents"
    }
  },
  "required": [
    "name"
  ]
}