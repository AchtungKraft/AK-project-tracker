{
  "name": "ProjectClientAccess",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "client_contact_id": {
      "type": "string",
      "description": "Reference to ClientContact"
    },
    "access_role": {
      "type": "string",
      "enum": [
        "viewer",
        "commenter",
        "approver"
      ],
      "default": "approver",
      "description": "Level of access for this client"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Current access status"
    },
    "share_token": {
      "type": "string",
      "description": "Unique token for shareable URL. Credential: readable by admins only; client endpoints validate it server-side.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "url_slug": {
      "type": "string",
      "description": "Custom URL slug for friendly access links"
    },
    "invite_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invite was sent"
    },
    "last_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When client last viewed the portal"
    },
    "last_notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last access notification was sent"
    }
  },
  "required": [
    "project_id",
    "client_contact_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}