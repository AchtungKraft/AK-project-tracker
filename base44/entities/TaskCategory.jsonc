{
  "name": "TaskCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Task category name"
    },
    "color": {
      "type": "string",
      "default": "#10B981",
      "description": "Hex color for visual identification"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID for hierarchy"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}