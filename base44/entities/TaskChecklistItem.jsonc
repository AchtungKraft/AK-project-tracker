{
  "name": "TaskChecklistItem",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Reference to parent Task"
    },
    "title": {
      "type": "string",
      "description": "Checklist item text"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is checked off"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the item was completed"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the checklist"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "client"
      ],
      "default": "internal",
      "description": "Future extension: whether visible to client portal"
    }
  },
  "required": [
    "task_id",
    "title"
  ]
}