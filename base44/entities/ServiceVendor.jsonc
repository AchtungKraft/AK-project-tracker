{
  "name": "ServiceVendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service vendor name"
    },
    "vendor_group_id": {
      "type": "string",
      "description": "Reference to VendorGroup (vendor_type=SERVICE). REQUIRED. Primary grouping key. Determines which services this vendor is available for."
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone (office/landline)"
    },
    "cell_phone": {
      "type": "string",
      "description": "Cell phone number"
    },
    "address": {
      "type": "string",
      "description": "Vendor address"
    },
    "website": {
      "type": "string",
      "description": "Vendor website URL"
    },
    "notes": {
      "type": "string",
      "description": "General internal notes"
    },
    "service_capabilities": {
      "type": "string",
      "description": "Description of services the vendor can provide"
    },
    "preferred_use_cases": {
      "type": "string",
      "description": "When to use this vendor over alternatives"
    },
    "vendor_instructions": {
      "type": "string",
      "description": "Operational instructions for working with this vendor (ordering, delivery, etc.)"
    },
    "pricing_notes": {
      "type": "string",
      "description": "Internal notes about pricing, minimums, payment terms"
    },
    "scheduling_notes": {
      "type": "string",
      "description": "Lead times, availability, scheduling considerations"
    },
    "internal_warnings": {
      "type": "string",
      "description": "Cautions, known issues, or reliability concerns"
    },
    "insurance_compliance_notes": {
      "type": "string",
      "description": "Insurance, compliance, or certification details"
    },
    "vendor_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique document ID"
          },
          "name": {
            "type": "string",
            "description": "Document display name"
          },
          "url": {
            "type": "string",
            "description": "File URL"
          },
          "type": {
            "type": "string",
            "enum": [
              "insurance_certificate",
              "w9",
              "pricing_sheet",
              "contract",
              "process_instructions",
              "example_photos",
              "capability_sheet",
              "other"
            ],
            "description": "Document type classification"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the document was uploaded"
          },
          "uploaded_by": {
            "type": "string",
            "description": "User who uploaded the document"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about the document"
          }
        }
      },
      "description": "Attached documents (insurance certs, W9, pricing sheets, contracts, etc.)"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When vendor details were last updated"
    },
    "last_updated_by": {
      "type": "string",
      "description": "Full name of user who last updated vendor details"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether vendor is active"
    }
  },
  "required": [
    "name",
    "vendor_group_id"
  ]
}