{
  "name": "ServiceVendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service vendor name"
    },
    "vendor_group_id": {
      "type": "string",
      "description": "Reference to VendorGroup (vendor_type=SERVICE). Primary grouping key."
    },
    "category": {
      "type": "string",
      "enum": [
        "shipping",
        "finishing",
        "coating",
        "plating",
        "fabrication",
        "upholstery",
        "electrical",
        "paint",
        "machine_work",
        "inspection",
        "general",
        "other"
      ],
      "default": "general",
      "description": "LEGACY: Vendor specialty category. Use vendor_group_id for canonical grouping."
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone (office/landline)"
    },
    "cell_phone": {
      "type": "string",
      "description": "Cell phone number"
    },
    "address": {
      "type": "string",
      "description": "Vendor address"
    },
    "website": {
      "type": "string",
      "description": "Vendor website URL"
    },
    "associated_service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to Service catalog entries this vendor provides"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether vendor is active"
    }
  },
  "required": [
    "name"
  ]
}