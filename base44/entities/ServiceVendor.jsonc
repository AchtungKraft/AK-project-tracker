{
  "name": "ServiceVendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service vendor name"
    },
    "vendor_group_id": {
      "type": "string",
      "description": "Reference to VendorGroup (vendor_type=SERVICE). REQUIRED. Primary grouping key. Determines which services this vendor is available for."
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone (office/landline)"
    },
    "cell_phone": {
      "type": "string",
      "description": "Cell phone number"
    },
    "address": {
      "type": "string",
      "description": "Vendor address"
    },
    "website": {
      "type": "string",
      "description": "Vendor website URL"
    },
    "notes": {
      "type": "string",
      "description": "General internal notes"
    },
    "service_capabilities": {
      "type": "string",
      "description": "Description of services the vendor can provide"
    },
    "preferred_use_cases": {
      "type": "string",
      "description": "When to use this vendor over alternatives"
    },
    "vendor_instructions": {
      "type": "string",
      "description": "Operational instructions for working with this vendor (ordering, delivery, etc.)"
    },
    "pricing_notes": {
      "type": "string",
      "description": "Internal notes about pricing, minimums, payment terms"
    },
    "scheduling_notes": {
      "type": "string",
      "description": "Lead times, availability, scheduling considerations"
    },
    "internal_warnings": {
      "type": "string",
      "description": "Cautions, known issues, or reliability concerns"
    },
    "insurance_compliance_notes": {
      "type": "string",
      "description": "Insurance, compliance, or certification details"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether vendor is active"
    }
  },
  "required": [
    "name",
    "vendor_group_id"
  ]
}