{
  "name": "CreditAllocation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "credit_ledger_id": {
      "type": "string",
      "description": "Reference to ProjectCreditLedger"
    },
    "commitment_id": {
      "type": "string",
      "description": "Reference to PartCommitment (nullable for project-level allocations)"
    },
    "invoice_id": {
      "type": "string",
      "description": "Reference to ProjectInvoice (nullable)"
    },
    "invoice_batch_id": {
      "type": "string",
      "description": "Reference to InvoiceBatch (nullable)"
    },
    "amount_applied": {
      "type": "number",
      "description": "Amount of credit applied. Positive for settlements; negative for a settlement_reversal compensating entry, so sums are always net."
    },
    "allocation_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "part_removal",
        "parts_settlement",
        "settlement_reversal",
        null
      ],
      "enumColors": [
        "gray",
        "green",
        "yellow",
        "gray"
      ],
      "description": "parts_settlement = general credit applied to a part without an invoice; settlement_reversal = compensating entry that returns part of a settlement to its original credit row. Null on older records."
    },
    "settlement_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Groups the entries of one settlement or one reversal (request key). Recorded on the part commitment once its billing quantities reflect it."
    },
    "settlement_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pending_commitment",
        "completed",
        null
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "description": "pending_commitment = credit moved but the part's billing quantities are not yet updated (invoicing for the project is blocked until finished); completed = fully recorded."
    },
    "qty_settled": {
      "type": [
        "number",
        "null"
      ],
      "description": "Part quantity this entry covers (negative on reversals)"
    },
    "unit_retail_at_settlement": {
      "type": [
        "number",
        "null"
      ],
      "description": "Part unit retail when settled"
    },
    "reverses_allocation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "settlement_reversal: the settlement entry it compensates"
    },
    "actor_email": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "allocation_mode": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "auto",
      "description": "Whether allocation was automatic or manual"
    },
    "allocation_key": {
      "type": "string",
      "description": "Deterministic hash for idempotency checks"
    },
    "is_reversed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this allocation has been reversed (legacy flag; settlement reversals use compensating entries instead)"
    },
    "reversed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When allocation was reversed"
    },
    "reversed_by": {
      "type": "string",
      "description": "User who reversed the allocation"
    },
    "reversal_reason": {
      "type": "string",
      "description": "Reason for reversal"
    }
  },
  "required": [
    "project_id",
    "credit_ledger_id",
    "amount_applied"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "credit_ledger_service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "credit_ledger_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "credit_ledger_service_only"
      }
    }
  }
}