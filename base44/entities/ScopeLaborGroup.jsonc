{
  "name": "ScopeLaborGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Labor group display name (e.g. Design, Install, Fabrication)"
    },
    "code": {
      "type": "string",
      "description": "Uppercase code identifier (e.g. DESIGN, INSTALL)"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Standard hourly rate in dollars"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this labor group is available for new estimates"
    },
    "description": {
      "type": "string",
      "description": "Optional description of this labor type"
    }
  },
  "required": [
    "name",
    "code",
    "hourly_rate"
  ]
}