{
  "name": "CustomPartOptionGroup",
  "type": "object",
  "properties": {
    "custom_part_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "single",
        "multiple"
      ],
      "default": "single"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "custom_part_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}