{
  "name": "ServiceLineItem",
  "type": "object",
  "properties": {
    "service_commitment_id": {
      "type": "string",
      "description": "Reference to ServiceCommitment"
    },
    "type": {
      "type": "string",
      "enum": [
        "vendor_cost",
        "shipping",
        "internal_labor",
        "misc"
      ],
      "default": "vendor_cost",
      "description": "Line item type"
    },
    "description": {
      "type": "string",
      "description": "Line item description"
    },
    "vendor_id": {
      "type": "string",
      "description": "Reference to ServiceVendor (optional, for vendor-related lines)"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "Cost per unit (or hourly rate for labor)"
    },
    "billing_rate": {
      "type": "number",
      "default": 0,
      "description": "Client billing rate per unit"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantity (or hours for labor)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "pricing_source": {
      "type": "string",
      "enum": [
        "matrix",
        "manual"
      ],
      "default": "manual",
      "description": "Whether pricing was derived from matrix suggestion or manually entered"
    },
    "matrix_reference_id": {
      "type": "string",
      "description": "Reference to RetailMarkupMatrix tier used (optional)"
    },
    "reference_id": {
      "type": "string",
      "description": "Optional external reference (PO, shipment, invoice, etc.)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "service_commitment_id",
    "type",
    "description"
  ]
}