{
  "name": "BuildKnowledgePartLink",
  "type": "object",
  "properties": {
    "knowledge_item_id": {
      "type": "string",
      "description": "Reference to BuildKnowledgeItem"
    },
    "part_id": {
      "type": "string",
      "description": "Reference to Part"
    },
    "requirement": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "conditional"
      ],
      "default": "required",
      "description": "Whether this part is required, optional, or conditional"
    },
    "estimated_qty": {
      "type": "number",
      "description": "Estimated quantity needed"
    },
    "install_notes": {
      "type": "string",
      "description": "Installation notes specific to this part in this procedure"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "knowledge_item_id",
    "part_id"
  ]
}