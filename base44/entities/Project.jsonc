{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "client_email": {
      "type": "string",
      "description": "Client email"
    },
    "client_phone": {
      "type": "string",
      "description": "Client phone"
    },
    "vin": {
      "type": "string",
      "description": "VIN or Chassis number"
    },
    "project_type_id": {
      "type": "string",
      "description": "Reference to ProjectType"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Project start date"
    },
    "target_completion": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "status_id": {
      "type": "string",
      "description": "Reference to StatusList"
    },
    "assigned_team": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of TeamMember IDs assigned to this project"
    },
    "progress_percent": {
      "type": "number",
      "default": 0,
      "description": "Auto-calculated from completed tasks"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of project/car image URLs"
    },
    "featured_image_url": {
      "type": "string",
      "description": "URL of the featured image to display on cards"
    },
    "is_shareable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this project can be shared via public link"
    },
    "client_last_viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a client last viewed this project portal"
    },
    "financial_model_version": {
      "type": "string",
      "enum": [
        "forward"
      ],
      "default": "forward",
      "description": "Financial model version. LOCKED to 'forward' (InvoiceBatch-based billing). Legacy pool model removed in Phase 9E."
    },
    "financial_model_migrated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When project was migrated to forward model"
    },
    "financial_model_migrated_by": {
      "type": "string",
      "description": "User who migrated project to forward model"
    },
    "is_system_project": {
      "type": "boolean",
      "default": false,
      "description": "If true, this is a system project (e.g., AK_STOCK) hidden from client views and excluded from invoicing"
    },
    "system_project_type": {
      "type": "string",
      "enum": [
        "AK_STOCK",
        "INTERNAL",
        "WARRANTY"
      ],
      "description": "Type of system project for special handling"
    },
    "current_phase_id": {
      "type": "string",
      "description": "Reference to current active ProjectKanbanBucket \u2014 set by resolver"
    },
    "current_phase_name": {
      "type": "string",
      "description": "Denormalized name of current phase for display"
    },
    "next_phase_id": {
      "type": "string",
      "description": "Reference to next ProjectKanbanBucket \u2014 set by resolver"
    },
    "next_phase_name": {
      "type": "string",
      "description": "Denormalized name of next phase for display"
    },
    "current_blocker": {
      "type": "string",
      "description": "Primary project-level blocker description"
    },
    "current_milestone_id": {
      "type": "string",
      "description": "Reference to last completed ProjectMilestone"
    },
    "current_milestone_name": {
      "type": "string",
      "description": "Denormalized name of last completed milestone"
    },
    "next_milestone_id": {
      "type": "string",
      "description": "Reference to next pending ProjectMilestone"
    },
    "next_milestone_name": {
      "type": "string",
      "description": "Denormalized name of next pending milestone"
    },
    "workflow_health": {
      "type": "object",
      "properties": {
        "tasks_ready": {
          "type": "number"
        },
        "tasks_blocked": {
          "type": "number"
        },
        "tasks_waiting": {
          "type": "number"
        },
        "tasks_in_progress": {
          "type": "number"
        },
        "tasks_completed": {
          "type": "number"
        },
        "hours_remaining": {
          "type": "number"
        },
        "hours_estimated": {
          "type": "number"
        },
        "hours_actual": {
          "type": "number"
        },
        "hours_logged_estimated_tasks": {
          "type": "number",
          "description": "Logged hours on tasks that have estimates"
        },
        "hours_logged_unestimated_tasks": {
          "type": "number",
          "description": "Logged hours on tasks without estimates"
        },
        "hours_variance_estimated_tasks": {
          "type": "number",
          "description": "Variance on estimated work only (logged on estimated tasks - estimated)"
        }
      },
      "description": "Denormalized workflow health snapshot \u2014 set by resolver"
    },
    "workflow_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the workflow was last resolved"
    }
  },
  "required": [
    "name"
  ]
}