      "type": "string",
      "description": "DEPRECATED"
    },
    "amount": {
      "type": "number",
      "description": "DEPRECATED"
    },
    "source_reference_id": {
      "type": "string",
      "description": "DEPRECATED"
    },
    "is_reversed": {
      "type": "boolean",
      "default": false,
      "description": "DEPRECATED"
    },
    "reversed_at": {
      "type": "string",
      "format": "date-time",
      "description": "DEPRECATED"
    },
    "reversed_by": {
      "type": "string",
      "description": "DEPRECATED"
    },
    "reversal_reason": {
      "type": "string",
      "description": "DEPRECATED"
    }
  },
  "required": [
