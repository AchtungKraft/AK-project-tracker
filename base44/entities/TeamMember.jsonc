{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Team member full name"
    },
    "team_role": {
      "type": "string",
      "description": "Role or specialty (e.g., Fabricator, Engineer, Project Manager)"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this team member is active"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User entity for syncing"
    },
    "company": {
      "type": "string",
      "description": "Company name for project access filtering"
    },
    "is_achtung_kraft_member": {
      "type": "boolean",
      "default": false,
      "description": "If true, can see all projects regardless of company"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "full_name"
  ]
}