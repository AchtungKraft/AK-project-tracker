{
  "name": "CarYear",
  "type": "object",
  "properties": {
    "year": {
      "type": "string",
      "description": "Year or year range/series (e.g., 1989, 1984-1989, 964)"
    },
    "car_model_id": {
      "type": "string",
      "description": "Reference to CarModel (parent)"
    },
    "description": {
      "type": "string",
      "description": "Year/series description (e.g., Generation details)"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "description": "Hex color for visual identification"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this year is available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "year",
    "car_model_id"
  ]
}