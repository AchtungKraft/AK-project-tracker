{
  "name": "DepositTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "register_existing",
        "apply",
        "apply_reversal",
        "refund",
        "refund_reversal",
        "qb_reconcile",
        "qb_correction"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "red",
        "purple",
        "gray",
        "pink"
      ],
      "description": "Append-only credit journal entry. Corrections are new entries that reference reverses_transaction_id; entries are never edited or deleted. Applications made when an invoice is sent use application_id send:{invoice}; credit returned when that invoice is cancelled uses cancel:{invoice}. qb_reconcile marks one item as entered in QuickBooks. qb_correction records an admin correction of a QuickBooks status (exported, linked or reconciled) with the original values in correction_detail."
    },
    "project_id": {
      "type": "string"
    },
    "client_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "application_id": {
      "type": "string",
      "description": "Groups the per-receipt portions of one application, refund or reversal (the request key)"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique per entry"
    },
    "credit_ledger_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ProjectCreditLedger row this entry draws from or restores (deposit or general credit; the row's origin decides which)"
    },
    "source_invoice_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Original invoice behind the credit (traceability to the receipt)"
    },
    "target_invoice_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Invoice the credit was applied to"
    },
    "reverses_transaction_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Entry this corrective entry reverses"
    },
    "reconciles_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "qb_reconcile / qb_correction: the item (invoice:{id}, payment:{id}, payment_reversal:{id} or app:{application_id})"
    },
    "amount_cents": {
      "type": "integer",
      "description": "Non-negative integer cents (0 for QuickBooks status corrections)"
    },
    "ledger_before_cents": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ledger_after_cents": {
      "type": [
        "integer",
        "null"
      ]
    },
    "method": {
      "type": [
        "string",
        "null"
      ],
      "description": "Refund method"
    },
    "reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "QuickBooks invoice/refund reference"
    },
    "transaction_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "note": {
      "type": "string"
    },
    "correction_detail": {
      "type": [
        "object",
        "null"
      ],
      "description": "qb_correction only: { status: exported|linked|reconciled, correction: to_linked|fix_reference|not_in_quickbooks, previous: {...}, next: {...}, export_id }"
    },
    "actor_email": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "project_id",
    "application_id",
    "idempotency_key",
    "amount_cents",
    "actor_email",
    "recorded_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "deposit_service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "deposit_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "deposit_service_only"
      }
    }
  }
}