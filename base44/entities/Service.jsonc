{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name (e.g. UPS Shipping, Chrome Plating)"
    },
    "preferred_vendor_group_id": {
      "type": "string",
      "description": "Reference to VendorGroup (vendor_type=SERVICE). REQUIRED. Canonical link that determines which vendors are available for this service."
    },
    "default_vendor_id": {
      "type": "string",
      "description": "Reference to preferred ServiceVendor"
    },
    "description": {
      "type": "string",
      "description": "Description of the service"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether service is active in catalog"
    }
  },
  "required": [
    "name",
    "preferred_vendor_group_id"
  ]
}