{
  "name": "ProjectType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project type name"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "description": "Hex color for visual identification"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent project type ID for hierarchy"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this type is available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}