{
  "name": "Task",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Task name"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to TaskCategory"
    },
    "assigned_team_member_id": {
      "type": "string",
      "description": "Reference to TeamMember"
    },
    "status_id": {
      "type": "string",
      "description": "Reference to StatusList \u2014 manual execution status set by user"
    },
    "kanban_bucket_id": {
      "type": "string",
      "description": "Reference to ProjectKanbanBucket (phase assignment)"
    },
    "is_priority": {
      "type": "boolean",
      "default": false,
      "description": "Flag indicating if this task is marked as priority"
    },
    "priority_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when priority was set. Cleared when priority is removed."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Task start date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Task due date"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time when task was marked as completed"
    },
    "estimated_hours": {
      "type": "number",
      "description": "Estimated time in decimal hours (e.g. 1.5 = 1h30m)"
    },
    "actual_hours": {
      "type": "number",
      "description": "Actual time spent in decimal hours, entered on completion"
    },
    "completed_by_user_id": {
      "type": "string",
      "description": "Reference to TeamMember who completed the task"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of predecessor Task IDs (finish-to-start). This task cannot start until all listed predecessors are complete."
    },
    "external_hours_ref": {
      "type": "string",
      "description": "Placeholder for imported QuickBooks line"
    },
    "operational_state": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "READY",
        "IN_PROGRESS",
        "WAITING_ON_PARTS",
        "WAITING_ON_VENDOR",
        "WAITING_ON_CUSTOMER",
        "BLOCKED",
        "REVIEW_REQUIRED",
        "COMPLETED",
        "CANCELLED"
      ],
      "description": "Calculated operational state from resolveProjectWorkflow. Do not set manually."
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DEPENDENCY",
              "PART",
              "PURCHASE_ORDER",
              "VENDOR",
              "CUSTOMER_APPROVAL",
              "INTERNAL_REVIEW",
              "PHASE",
              "ASSIGNMENT",
              "MANUAL_HOLD",
              "DATA_CONFIGURATION"
            ]
          },
          "label": {
            "type": "string"
          },
          "relatedTaskId": {
            "type": "string"
          },
          "relatedEntityId": {
            "type": "string"
          }
        }
      },
      "description": "Specific blocking reasons from the resolver"
    },
    "manual_override": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "HOLD",
            "FORCE_READY",
            "FORCE_BLOCKED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "set_by": {
          "type": "string"
        },
        "set_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Manual override of calculated state"
    },
    "requires_customer_approval": {
      "type": "boolean",
      "default": false,
      "description": "Whether this task requires customer approval before work can proceed"
    },
    "customer_approval_request_id": {
      "type": "string",
      "description": "Reference to ClientFeedbackRequest for required approval"
    },
    "requires_vendor_work": {
      "type": "boolean",
      "default": false,
      "description": "Whether this task depends on external vendor work"
    },
    "vendor_service_commitment_id": {
      "type": "string",
      "description": "Reference to ServiceCommitment for vendor work dependency"
    },
    "state_resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the operational state was last calculated"
    },
    "labor_billing_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "UNCLASSIFIED",
        "BILLABLE",
        "INCLUDED_IN_SERVICE",
        "NON_BILLABLE",
        null
      ],
      "description": "Labor billing classification. Missing/null = UNCLASSIFIED. Only BILLABLE generates labor billing. Admin-only via laborBillingAction.",
      "rls": {
        "create": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "labor_service_commitment_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required when INCLUDED_IN_SERVICE: same-project ServiceCommitment that already charges this labor",
      "rls": {
        "create": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "labor_rate_override": {
      "type": [
        "number",
        "null"
      ],
      "description": "Optional approved hourly rate for this task; takes precedence over project rate",
      "rls": {
        "create": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "labor_classified_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Admin email who last set labor billing fields",
      "rls": {
        "create": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "labor_classified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When labor billing fields were last set",
      "rls": {
        "create": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_phase_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether this task must be completed for its phase to be considered complete"
    }
  },
  "required": [
    "name",
    "project_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}