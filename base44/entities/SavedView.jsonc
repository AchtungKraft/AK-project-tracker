{
  "name": "SavedView",
  "type": "object",
  "properties": {
    "view_name": {
      "type": "string",
      "description": "Display name of the saved view"
    },
    "view_type": {
      "type": "string",
      "enum": [
        "projects",
        "priorities",
        "client_portal"
      ],
      "default": "projects",
      "description": "Which page this view applies to"
    },
    "selected_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of selected project type IDs"
    },
    "status_filter": {
      "type": "string",
      "default": "all",
      "description": "Status filter value"
    },
    "is_shared": {
      "type": "boolean",
      "default": true,
      "description": "If true, available to all Achtung Kraft users"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "view_name"
  ]
}