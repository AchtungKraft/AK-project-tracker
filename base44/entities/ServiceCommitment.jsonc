{
  "name": "ServiceCommitment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "service_id": {
      "type": "string",
      "description": "Reference to Service catalog entry"
    },
    "description": {
      "type": "string",
      "description": "Instance description (e.g. Shipment #2, Chrome plating batch)"
    },
    "vendor_id": {
      "type": "string",
      "description": "Reference to ServiceVendor for this instance"
    },
    "estimated_cost": {
      "type": "number",
      "default": 0,
      "description": "LEGACY: Single estimated cost. Use ServiceLineItem totals instead."
    },
    "actual_cost": {
      "type": "number",
      "description": "LEGACY: Actual cost once known. Use ServiceLineItem totals instead."
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "DERIVED: Sum of all ServiceLineItem (cost * quantity)"
    },
    "total_billable": {
      "type": "number",
      "default": 0,
      "description": "DERIVED: Sum of all ServiceLineItem (billing_rate * quantity)"
    },
    "planned_cost": {
      "type": "number",
      "default": 0,
      "description": "SNAPSHOT: Total cost at commitment creation time. Never changes after creation."
    },
    "planned_billable": {
      "type": "number",
      "default": 0,
      "description": "SNAPSHOT: Total billable at commitment creation time. Never changes after creation."
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantity (usually 1 for services)"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ordered",
        "completed",
        "billed"
      ],
      "default": "planned",
      "description": "Service commitment lifecycle status"
    },
    "is_billed": {
      "type": "boolean",
      "default": false,
      "description": "CANONICAL: Explicit billing flag. True when invoice has been sent. Only markInvoiceSent may set this."
    },
    "invoice_id": {
      "type": "string",
      "description": "Reference to ProjectInvoice that billed this service. Null until invoiced."
    },
    "cost_override": {
      "type": "boolean",
      "default": false,
      "description": "True when user manually overrides cost. Prevents vendor cost sync from overwriting."
    },
    "retail_override": {
      "type": "boolean",
      "default": false,
      "description": "True when user manually overrides billing rate. Prevents recalculation."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "ordered_date": {
      "type": "string",
      "format": "date",
      "description": "When service was ordered"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "When service was completed"
    },
    "billed_date": {
      "type": "string",
      "format": "date",
      "description": "When service was billed to client"
    },
    "invoice_reference": {
      "type": "string",
      "description": "LEGACY: Client invoice reference string. Use invoice_id for canonical linkage."
    }
  },
  "required": [
    "project_id",
    "service_id",
    "description"
  ]
}