{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "vendor_name": {
      "type": "string",
      "description": "Vendor/supplier name"
    },
    "vendor_type": {
      "type": "string",
      "enum": [
        "PART",
        "SERVICE"
      ],
      "description": "Whether this is a parts vendor or a service vendor"
    },
    "vendor_group_id": {
      "type": "string",
      "description": "Reference to VendorGroup"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent vendor ID for hierarchy (e.g., supplier groups)"
    },
    "website": {
      "type": "string",
      "description": "Website or ordering link"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone (office/landline)"
    },
    "cell_phone": {
      "type": "string",
      "description": "Cell phone number"
    },
    "address": {
      "type": "string",
      "description": "Vendor address"
    },
    "contact_info": {
      "type": "string",
      "description": "LEGACY: General contact information. Use contact_name/email/phone instead."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "description": "Hex color for visual identification"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this vendor is active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "vendor_name"
  ]
}