{
  "name": "ScopeGroup",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Reference to ClientFeedbackRequest (scope review)"
    },
    "name": {
      "type": "string",
      "description": "Group name (e.g. EXTERIOR, INTERIOR, ENGINE BAY)"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Manual display order \u2014 request-level, independent of category"
    }
  },
  "required": [
    "request_id",
    "name"
  ]
}