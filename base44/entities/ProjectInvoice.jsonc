{
  "name": "ProjectInvoice",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "invoice_type": {
      "type": "string",
      "enum": [
        "deposit",
        "progress",
        "final"
      ],
      "description": "Type of invoice in billing lifecycle"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partial",
        "paid",
        "overdue",
        "void",
        "cancelled"
      ],
      "default": "draft",
      "description": "Invoice status \u2014 canonical billing lifecycle"
    },
    "qb_invoice_number": {
      "type": "string",
      "description": "QuickBooks invoice number (set when sent)"
    },
    "qb_invoice_date": {
      "type": "string",
      "format": "date",
      "description": "QuickBooks invoice date (manual metadata entry)"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Date invoice was issued"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment was received"
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Sum of all line totals before credits"
    },
    "credit_proposed": {
      "type": "number",
      "default": 0,
      "description": "Credit amount proposed at draft creation (deposit + general when credit_selection_mode is split). NOT deducted from ledger until sent."
    },
    "credit_selection_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "split",
        null
      ],
      "description": "split = draft names deposit credit and general credit separately and each is drawn only from its own kind at send. Null on older drafts: credit_proposed is drawn from any credit, oldest first (legacy behavior, preserved)."
    },
    "credit_proposed_deposit": {
      "type": "number",
      "default": 0,
      "description": "split drafts: deposit-origin credit selected for this invoice"
    },
    "credit_proposed_general": {
      "type": "number",
      "default": 0,
      "description": "split drafts: general project credit selected for this invoice"
    },
    "credit_applied_deposit": {
      "type": "number",
      "default": 0,
      "description": "Deposit-origin credit deducted at send"
    },
    "credit_applied_general": {
      "type": "number",
      "default": 0,
      "description": "General project credit deducted at send"
    },
    "credit_applied": {
      "type": "number",
      "default": 0,
      "description": "Credit deducted from the ledger: at send (markInvoiceSent) plus later deposit applications (projectDepositAction)."
    },
    "credit_preview": {
      "type": "number",
      "default": 0,
      "description": "DEPRECATED: Legacy field. Use credit_proposed for drafts, credit_applied for sent."
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Invoice total (same as subtotal, tax handled externally)"
    },
    "balance_due": {
      "type": "number",
      "default": 0,
      "description": "Amount due after credit applied"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount actually paid"
    },
    "notes": {
      "type": "string",
      "description": "Invoice notes"
    },
    "recorded_from_quickbooks": {
      "type": "boolean",
      "default": false,
      "description": "True when this deposit invoice was registered from an invoice that already exists in QuickBooks (Record Existing Down Payment). Must not be re-created in QuickBooks."
    },
    "qb_export_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "exported",
        "linked",
        null
      ],
      "description": "AK-created invoice already in QuickBooks: exported = included in a QuickBooks export file; linked = admin confirmed it already exists in QuickBooks. Null = not yet in QuickBooks. Deposit invoices with a value here (or recorded_from_quickbooks) are excluded from new QuickBooks exports. Changed only by export or the admin correction workflow."
    },
    "qb_export_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "export_number of the QuickBooksExport file that included this deposit invoice"
    },
    "qb_exported_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "qb_exported_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "qb_link_reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "QuickBooks reference the admin confirmed when linking"
    },
    "qb_linked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "qb_linked_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "credit_idempotency_key": {
      "type": "string",
      "description": "Idempotency key for credit application (set at sent time)"
    },
    "payment_idempotency_key": {
      "type": "string",
      "description": "Idempotency key for payment processing"
    },
    "credit_application_plan": {
      "type": "array",
      "description": "Server-only journal of ledger deductions made by markInvoiceSent (written before deducting) so a retry after a crash can reconcile instead of deducting twice.",
      "items": {
        "type": "object",
        "properties": {
          "credit_id": {
            "type": "string"
          },
          "credit_class": {
            "type": [
              "string",
              "null"
            ],
            "description": "deposit | general | any (legacy draft)"
          },
          "amount": {
            "type": "number"
          },
          "before": {
            "type": "number"
          },
          "after": {
            "type": "number"
          },
          "prev_applied_to_invoice_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "prev_credit_idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "credit_plan_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pending",
        "applied",
        null
      ],
      "description": "pending = deductions may be partially applied (retry reconciles); applied = committed with the sent transition"
    },
    "apply_credit_at_payment": {
      "type": "boolean",
      "default": false,
      "description": "DEPRECATED: Legacy flag. Credits are now always applied at sent time."
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when invoice was cancelled"
    },
    "cancelled_by": {
      "type": "string",
      "description": "User who cancelled the invoice"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Reason for cancellation"
    },
    "credit_reversed": {
      "type": "number",
      "default": 0,
      "description": "Amount of credit that was reversed on cancellation"
    },
    "reversal_idempotency_key": {
      "type": "string",
      "description": "Idempotency key for credit reversal on cancellation"
    }
  },
  "required": [
    "project_id",
    "invoice_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}