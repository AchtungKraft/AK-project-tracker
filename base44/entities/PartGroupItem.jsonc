{
  "name": "PartGroupItem",
  "type": "object",
  "properties": {
    "part_group_id": {
      "type": "string",
      "description": "Reference to PartGroup"
    },
    "part_id": {
      "type": "string",
      "description": "Reference to Part"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Standard quantity required for this group"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within section"
    },
    "section_name": {
      "type": "string",
      "description": "Optional section grouping within the parts group"
    },
    "notes": {
      "type": "string",
      "description": "Group-specific usage notes for this part"
    },
    "is_optional": {
      "type": "boolean",
      "default": false,
      "description": "Whether this part is optional vs required"
    }
  },
  "required": [
    "part_group_id",
    "part_id"
  ]
}