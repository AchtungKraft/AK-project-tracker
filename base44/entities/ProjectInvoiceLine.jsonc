{
  "name": "ProjectInvoiceLine",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Reference to ProjectInvoice"
    },
    "type": {
      "type": "string",
      "enum": [
        "part",
        "service",
        "manual",
        "outside_cost",
        "credit_adjustment"
      ],
      "description": "Line item type \u2014 part, service, manual, outside_cost, credit_adjustment"
    },
    "source_entity": {
      "type": "string",
      "enum": [
        "PartCommitment",
        "ServiceCommitment",
        "Manual"
      ],
      "description": "CANONICAL: Entity type this line references. Used by sent/paid mutations."
    },
    "source_id": {
      "type": "string",
      "description": "CANONICAL: ID of the source record (PartCommitment or ServiceCommitment). Replaces part_commitment_id for unified lookups."
    },
    "part_commitment_id": {
      "type": "string",
      "description": "LEGACY: Reference to PartCommitment (for type=part). Kept for backward compat. Use source_id for new code."
    },
    "part_id": {
      "type": "string",
      "description": "Reference to Part (denormalized for export)"
    },
    "part_name": {
      "type": "string",
      "description": "Part name (snapshot for export)"
    },
    "part_number": {
      "type": "string",
      "description": "Vendor part number (snapshot for export)"
    },
    "description": {
      "type": "string",
      "description": "Line item description / long description for export"
    },
    "qty": {
      "type": "number",
      "description": "Quantity invoiced"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "description": "Retail price per unit"
    },
    "line_total": {
      "type": "number",
      "default": 0,
      "description": "Total for this line (qty * unit_price)"
    },
    "unit_cost": {
      "type": "number",
      "description": "Cost per unit (internal, for margin tracking)"
    },
    "cost_total": {
      "type": "number",
      "description": "Total cost for this line (qty * unit_cost) \u2014 for margin reporting"
    },
    "vendor_id": {
      "type": "string",
      "description": "Vendor ID (denormalized for export/reporting)"
    },
    "vendor_name": {
      "type": "string",
      "description": "Vendor name (snapshot for export)"
    },
    "category_id": {
      "type": "string",
      "description": "Part category ID (denormalized for export/reporting)"
    },
    "category_name": {
      "type": "string",
      "description": "Category name (snapshot for export)"
    },
    "needs_review": {
      "type": "boolean",
      "default": false,
      "description": "Flag for lines with missing or zero retail that need review"
    },
    "review_reason": {
      "type": "string",
      "description": "Reason line was flagged for review"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "metadata": {
      "type": "object",
      "description": "Extensible metadata bag for line-specific context (service details, etc.)"
    }
  },
  "required": [
    "invoice_id",
    "type",
    "description"
  ]
}