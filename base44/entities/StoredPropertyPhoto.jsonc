{
  "name": "StoredPropertyPhoto",
  "type": "object",
  "properties": {
    "stored_property_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Content entry this photo belongs to. Null = unsorted photo saved directly to the container (quick capture)."
    },
    "file_uri": {
      "type": "string",
      "description": "Private Base44 file URI of the original upload; never a public or signed URL"
    },
    "thumbnail_uri": {
      "type": [
        "string",
        "null"
      ],
      "description": "Private file URI of a separately generated preview image. The original file is never replaced."
    },
    "capture_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Per-image idempotency key assigned on the device before upload. Unique per container; retries return the existing record."
    },
    "original_file_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_size_bytes": {
      "type": [
        "number",
        "null"
      ]
    },
    "media_asset_id": {
      "type": "string",
      "description": "Optional managed media asset"
    },
    "capture_batch_id": {
      "type": "string",
      "description": "Same photo intake session"
    },
    "container_id": {
      "type": "string",
      "description": "Container the photo is saved to (provenance)"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "caption": {
      "type": "string"
    },
    "captured_by": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "file_uri",
    "container_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}