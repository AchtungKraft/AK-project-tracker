{
  "name": "BuildKnowledgeItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline of the knowledge entry"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug for the item"
    },
    "type": {
      "type": "string",
      "enum": [
        "procedure",
        "guide",
        "issue",
        "reference",
        "checklist",
        "tip",
        "document"
      ],
      "default": "procedure",
      "description": "Content type classification"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to PartCategory (shared taxonomy)"
    },
    "subcategory_id": {
      "type": "string",
      "description": "Reference to PartCategory child (shared taxonomy)"
    },
    "vehicle_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vehicle model/make tags for filtering (e.g. E9, 911, 356)"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary shown in lists and search results"
    },
    "content_html": {
      "type": "string",
      "description": "Rich HTML content from WYSIWYG editor \u2014 primary content field"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded image gallery URLs"
    },
    "reference_url": {
      "type": "string",
      "description": "Single optional reference URL (vendor docs, YouTube, OEM PDF, forum thread)"
    },
    "content_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "heading",
              "checklist",
              "image",
              "gallery",
              "pdf",
              "link",
              "warning",
              "note",
              "video",
              "file",
              "step"
            ]
          },
          "order": {
            "type": "number"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "description": "Legacy content blocks \u2014 preserved for backward compatibility"
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "resolution": {
            "type": "string"
          }
        }
      },
      "description": "Legacy known issues \u2014 preserved for backward compatibility"
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "description": "Legacy tips \u2014 preserved for backward compatibility"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "caution",
              "warning",
              "danger"
            ]
          }
        }
      },
      "description": "Legacy warnings \u2014 preserved for backward compatibility"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "description": "File attachments (PDFs, documents)"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy media asset URLs"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number, incremented on significant edits"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Version history changelog"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Publication status"
    }
  },
  "required": [
    "title"
  ]
}