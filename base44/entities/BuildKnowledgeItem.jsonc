{
  "name": "BuildKnowledgeItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline of the knowledge entry"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug for the item"
    },
    "type": {
      "type": "string",
      "enum": [
        "procedure",
        "guide",
        "issue",
        "reference",
        "checklist",
        "tip",
        "document"
      ],
      "default": "procedure",
      "description": "Legacy content type classification"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "procedure",
        "observation",
        "known_issue",
        "reference",
        "tip"
      ],
      "default": "procedure",
      "description": "Operational post classification for feed filtering"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Whether this entry is pinned to top of its subsystem feed"
    },
    "is_master_procedure": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a master/canonical procedure for its subsystem"
    },
    "parent_procedure_id": {
      "type": "string",
      "description": "Optional reference to a master procedure this post is attached to"
    },
    "cover_image_url": {
      "type": "string",
      "description": "Primary cover image URL displayed prominently in cards and detail view"
    },
    "is_obsolete": {
      "type": "boolean",
      "default": false,
      "description": "Whether this post is outdated and should not be referenced"
    },
    "superseded_by_id": {
      "type": "string",
      "description": "ID of the knowledge item that replaces this one"
    },
    "last_referenced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this post was last referenced from a task or project"
    },
    "category_id": {
      "type": "string",
      "description": "Reference to PartCategory (shared taxonomy)"
    },
    "subcategory_id": {
      "type": "string",
      "description": "Reference to PartCategory child (shared taxonomy)"
    },
    "vehicle_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vehicle model/make tags for filtering"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary shown in lists and search results"
    },
    "content_html": {
      "type": "string",
      "description": "Rich HTML content from WYSIWYG editor"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded image gallery URLs"
    },
    "reference_url": {
      "type": "string",
      "description": "Single optional reference URL"
    },
    "content_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "heading",
              "checklist",
              "image",
              "gallery",
              "pdf",
              "link",
              "warning",
              "note",
              "video",
              "file",
              "step"
            ]
          },
          "order": {
            "type": "number"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "description": "Legacy content blocks"
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "resolution": {
            "type": "string"
          }
        }
      },
      "description": "Legacy known issues"
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "description": "Legacy tips"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "caution",
              "warning",
              "danger"
            ]
          }
        }
      },
      "description": "Legacy warnings"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "description": "File attachments"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy media asset URLs"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Version history changelog"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Publication status"
    }
  },
  "required": [
    "title"
  ]
}