{
  "name": "StorageLabelCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Storage identification category shown on tote labels (not a parts or purchasing category)"
    },
    "color": {
      "type": "string",
      "description": "Label color as #RRGGBB. Print automatically darkens light colors for contrast."
    },
    "key": {
      "type": "string",
      "description": "Stable system key. 'general' is the fallback for containers without a category."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "color"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}