{
  "name": "StorageLabelCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Sticker category shown on tote labels (visual identification only; not a parts, inventory, project, location or purchasing category). Unique, case-insensitive."
    },
    "color": {
      "type": "string",
      "description": "Label color as #RRGGBB. Print automatically darkens light colors for contrast."
    },
    "key": {
      "type": "string",
      "description": "Stable system key for defaults. 'general' is the fallback for containers without a category."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive categories stay on existing totes but cannot be newly assigned. Categories are never hard-deleted."
    }
  },
  "required": [
    "name",
    "color"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "sticker_category_service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "sticker_category_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "sticker_category_service_only"
      }
    }
  }
}