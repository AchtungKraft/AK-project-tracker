{
  "name": "ScopeItemLaborEstimate",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Reference to ClientFeedbackRequest (denormalized for efficient queries)"
    },
    "scope_item_id": {
      "type": "string",
      "description": "Reference to ScopeItem"
    },
    "labor_group_id": {
      "type": "string",
      "description": "Reference to ScopeLaborGroup"
    },
    "labor_group_name_snapshot": {
      "type": "string",
      "description": "Snapshot of the labor group name at time of estimate creation"
    },
    "hours_min": {
      "type": [
        "number",
        "null"
      ],
      "description": "Low hours (decimals ok). Low only = exact; null with hours_max = 'Up to'; both null and not TBD = description only. Null is never 0."
    },
    "hours_max": {
      "type": [
        "number",
        "null"
      ],
      "description": "High hours (decimals ok). Null with hours_min set = exact estimate."
    },
    "hours_tbd": {
      "type": "boolean",
      "default": false,
      "description": "Explicit TBD: hours not yet estimated. Hours are cleared when set."
    },
    "rate_snapshot": {
      "type": "number",
      "description": "Hourly rate at time of estimate creation \u2014 never silently updated"
    },
    "description": {
      "type": "string",
      "description": "Client-facing operation or deliverable description"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the scope item"
    }
  },
  "required": [
    "request_id",
    "scope_item_id",
    "labor_group_id",
    "rate_snapshot"
  ]
}