{
  "name": "ProjectCustomPart",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "custom_part_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "selected_options": {
      "type": "object",
      "description": "Draft option group ID to choice ID(s) mapping"
    },
    "internal_notes": {
      "type": "string"
    },
    "selection_status": {
      "type": "string",
      "enum": [
        "NOT_SELECTED",
        "DRAFT",
        "READY_FOR_REVIEW",
        "SUBMITTED",
        "APPROVED",
        "CHANGES_REQUESTED"
      ],
      "default": "NOT_SELECTED"
    },
    "approved_revision": {
      "type": "integer",
      "default": 0
    },
    "current_revision": {
      "type": "integer",
      "default": 1
    }
  },
  "required": [
    "project_id",
    "custom_part_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}