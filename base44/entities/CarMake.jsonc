{
  "name": "CarMake",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Car manufacturer name (e.g., Porsche, BMW)"
    },
    "description": {
      "type": "string",
      "description": "Make description"
    },
    "color": {
      "type": "string",
      "default": "#3B82F6",
      "description": "Hex color for visual identification"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this make is available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}