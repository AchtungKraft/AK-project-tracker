{
  "name": "PhaseTransitionLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project"
    },
    "phase_id": {
      "type": "string",
      "description": "Reference to ProjectKanbanBucket"
    },
    "phase_name": {
      "type": "string",
      "description": "Denormalized phase name at time of transition"
    },
    "from_status": {
      "type": "string",
      "description": "Previous phase status"
    },
    "to_status": {
      "type": "string",
      "description": "New phase status"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the transition"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "migration"
      ],
      "default": "automatic",
      "description": "Whether transition was automatic, user-initiated, or a migration normalization"
    },
    "trigger_entity_type": {
      "type": "string",
      "enum": [
        "task",
        "milestone",
        "phase",
        "resolver"
      ],
      "description": "Type of entity that triggered the transition"
    },
    "trigger_entity_id": {
      "type": "string",
      "description": "ID of the entity that triggered the transition"
    },
    "user_name": {
      "type": "string",
      "description": "User who triggered the transition (if manual)"
    },
    "resolver_version": {
      "type": "number",
      "default": 2,
      "description": "Version of the resolver that created this log"
    }
  },
  "required": [
    "project_id",
    "phase_id",
    "from_status",
    "to_status"
  ]
}